# ─── Stellar / Soroban Network ──────────────────────────────────────────────────
# Set to "mainnet" for production
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── Automation Signer ──────────────────────────────────────────────────────────
# Keypair of the automation service account.
# This account MUST be configured as one of the router recipients (e.g. 1 bps)
# so that it is authorised to call distribute().
# Generate a testnet keypair via:
#   stellar keys generate automation-signer --network testnet
AUTOMATION_SECRET_KEY=
AUTOMATION_PUBLIC_KEY=

# ─── Payment Router ─────────────────────────────────────────────────────────────
# Comma-separated list of Soroban contract IDs that this service is allowed
# to trigger. Requests for any other contract ID will be rejected.
ROUTER_CONTRACT_ID=

# ─── Router Token Contract ──────────────────────────────────────────────────────
# Soroban contract ID of the SEP-41 token the router holds and distributes.
# This must match the token the router was initialized with (not necessarily USDC).
#
# On testnet, use the native XLM Stellar Asset Contract (SAC) if the router
# was initialized with native XLM:
#   CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
#
# Note: the legacy testnet USDC address (CBIELTK6...) requires admin minting
# rights and will not work for balance checks without a trustline.
USDC_CONTRACT_ID=

# ─── Webhook Security ───────────────────────────────────────────────────────────
# Shared secret that callers must supply in the x-automation-secret header.
# Use a strong random value (e.g. openssl rand -hex 32).
AUTOMATION_WEBHOOK_SECRET=

# ─── Escrow Event Listener ───────────────────────────────────────────
# Comma-separated Soroban contract IDs to monitor for fund events.
CONTRACT_IDS=
