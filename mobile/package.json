{
  "name": "trustless-work-mobile",
  "version": "0.1.0",
  "description": "Trustless Work Mobile version with Meridian Wallet support",
  "main": "src/App.tsx",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "setup:meridian": "echo 'Configure Meridian OS repo path in .env'"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4",
    "react-navigation": "^6.1.9",
    "react-native-screens": "^3.29.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "ethers": "^6.10.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/runtime": "^7.23.9",
    "@types/react": "^18.2.55",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.19.1",
    "@typescript-eslint/eslint-plugin": "^6.19.1"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
