# Meridian Wallet Configuration
# Clone o repositório Meridian OS e configure estas variáveis

# URL do nó RPC da rede Ethereum
ETHERSCAN_RPC_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID

# Endereço do contrato inteligente Meridian (quando disponível)
MERIDIAN_CONTRACT_ADDRESS=0x

# Chave da aplicação (para desenvolvimento)
APP_SECRET=your-secret-key-here

# Ambiente (development, staging, production)
NODE_ENV=development
